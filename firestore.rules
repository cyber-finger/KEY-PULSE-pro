rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'bestWpm', 'testsCompleted']) &&
             data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'bestWpm', 'bestCpm', 'testsCompleted', 'averageAccuracy', 'totalWordsTyped', 'achievementPoints', 'unlockedBadgeIds', 'pinnedBadgeId', 'favoriteQuote', 'lastUsernameChangeDate', 'updatedAt']) &&
             data.uid == request.auth.uid &&
             data.displayName is string && data.displayName.size() <= 100 &&
             (!('favoriteQuote' in data) || (data.favoriteQuote is string && data.favoriteQuote.size() <= 250)) &&
             (!('lastUsernameChangeDate' in data) || data.lastUsernameChangeDate is string) &&
             data.bestWpm is number && data.bestWpm >= 0 && data.bestWpm <= 400 &&
             data.testsCompleted is number && data.testsCompleted >= 0;
    }

    function isValidTypingSession(data) {
      return data.keys().hasAll(['id', 'userId', 'wpm', 'cpm', 'accuracy', 'duration']) &&
             data.keys().hasOnly(['id', 'userId', 'wpm', 'cpm', 'rawWpm', 'accuracy', 'duration', 'characterCount', 'errorCount', 'mode', 'category', 'timestamp']) &&
             data.userId == request.auth.uid &&
             data.wpm is number && data.wpm >= 0 && data.wpm <= 400 &&
             data.cpm is number && data.cpm >= 0 && data.cpm <= 2500 &&
             data.accuracy is number && data.accuracy >= 0 && data.accuracy <= 100 &&
             data.duration is number && data.duration >= 0 && data.duration <= 3600;
    }

    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll(['id', 'userId', 'displayName', 'wpm', 'cpm', 'accuracy', 'mode']) &&
             data.keys().hasOnly(['id', 'userId', 'displayName', 'photoURL', 'wpm', 'cpm', 'accuracy', 'mode', 'category', 'pinnedBadgeId', 'achievementPoints', 'favoriteQuote', 'timestamp']) &&
             data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() <= 100 &&
             (!('favoriteQuote' in data) || (data.favoriteQuote is string && data.favoriteQuote.size() <= 250)) &&
             data.wpm is number && data.wpm >= 0 && data.wpm <= 400 &&
             data.cpm is number && data.cpm >= 0 && data.cpm <= 2500 &&
             data.accuracy is number && data.accuracy >= 0 && data.accuracy <= 100 &&
             data.mode is string && data.mode.size() <= 50;
    }

    function isValidCustomText(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'content']) &&
             data.keys().hasOnly(['id', 'userId', 'title', 'content', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 120 &&
             data.content is string && data.content.size() > 0 && data.content.size() <= 5000;
    }

    // User profiles
    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidUserProfile(incoming());
      allow delete: if false;

      // User typing history sessions
      match /sessions/{sessionId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;
        allow create, update: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidId(sessionId) && isValidTypingSession(incoming());
        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidId(sessionId);
      }

      // User custom practice texts
      match /custom_texts/{textId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;
        allow create, update: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidId(textId) && isValidCustomText(incoming());
        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidId(textId);
      }
    }

    // Global competitive leaderboard
    match /leaderboard/{entryId} {
      allow get, list: if true;
      allow create, update: if isSignedIn() && isValidId(entryId) && incoming().userId == request.auth.uid && isValidLeaderboardEntry(incoming());
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
